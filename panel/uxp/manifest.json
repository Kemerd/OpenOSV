{
  "manifestVersion": 5,
  "id": "com.openosv.panel",
  "name": "OpenOSV",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "openosvPanel",
      "label": {
        "default": "OpenOSV"
      },
      "minimumSize": {
        "width": 220,
        "height": 260
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 460
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 480
      }
    }
  ],
  "requiredPermissions": {}
}
