{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "openosv",
  "version-string": "0.2.0",
  "description": "Independent open-source DJI Osmo 360 .OSV toolkit: parser, stitcher, reframer, HDR colour pipeline",
  "license": "Apache-2.0",
  "builtin-baseline": "a97c98d785fc0b1710bc711acf47767b756e6b7c",
  "dependencies": [
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swscale",
        "swresample",
        "nvcodec",
        "zlib"
      ]
    },
    "ffnvcodec",
    "opencl",
    "catch2",
    "nlohmann-json",
    "cli11",
    "spdlog",
    "fmt",
    "tinyexr"
  ]
}
