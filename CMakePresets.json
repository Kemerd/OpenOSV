{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_MANIFEST_MODE": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "ninja-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      },
      "architecture": { "value": "x64", "strategy": "external" }
    },
    {
      "name": "cuda-vars",
      "hidden": true,
      "cacheVariables": {
        "OSV_ENABLE_CUDA": "ON",
        "OSV_ENABLE_OPENCL": "ON",
        "CMAKE_CUDA_COMPILER": "$env{CUDA_PATH}/bin/nvcc.exe",
        "CMAKE_CUDA_ARCHITECTURES": "75-real;86-real;89-real;120-real;120-virtual",
        "CMAKE_CUDA_HOST_COMPILER": "cl"
      }
    },
    {
      "name": "windows-msvc-cuda-release",
      "displayName": "Windows MSVC x64 Release (CUDA + OpenCL, Ninja)",
      "inherits": [ "ninja-base", "cuda-vars" ],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-msvc-cuda-debug",
      "displayName": "Windows MSVC x64 Debug (CUDA + OpenCL, Ninja)",
      "inherits": [ "ninja-base", "cuda-vars" ],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-msvc-premiere-release",
      "displayName": "Windows MSVC x64 Release + Premiere Pro plug-ins (CUDA + OpenCL, Ninja)",
      "inherits": [ "ninja-base", "cuda-vars" ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OSV_BUILD_PREMIERE": "ON",
        "OSV_PREMIERE_SDK_DIR": "${sourceDir}/Premiere Pro 26.0 C++ SDK",
        "OSV_AE_SDK_DIR": "${sourceDir}/third_party/ae-sdk"
      }
    },
    {
      "name": "windows-msvc-premiere-debug",
      "displayName": "Windows MSVC x64 Debug + Premiere Pro plug-ins (CUDA + OpenCL, Ninja)",
      "inherits": "windows-msvc-premiere-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-msvc-cpu-only",
      "displayName": "Windows MSVC x64 Release (CPU only, Ninja)",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OSV_ENABLE_CUDA": "OFF",
        "OSV_ENABLE_OPENCL": "OFF"
      }
    },
    {
      "name": "windows-vs2022-cuda",
      "displayName": "Windows Visual Studio 17 2022 x64 (CUDA + OpenCL)",
      "inherits": [ "base", "cuda-vars" ],
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "ci-windows",
      "displayName": "CI (GitHub Actions windows-latest)",
      "inherits": "windows-msvc-cuda-release",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "89-real;120-real",
        "OSV_WARNINGS_AS_ERRORS": "ON",
        "VCPKG_INSTALL_OPTIONS": "--clean-after-build"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx-openosv",
        "VCPKG_HOST_TRIPLET": "arm64-osx",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_MANIFEST_MODE": "ON",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3",
        "OSV_ENABLE_CUDA": "OFF",
        "OSV_ENABLE_OPENCL": "OFF"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "macos-release",
      "displayName": "macOS arm64 Release (AppleClang, Ninja)",
      "inherits": "macos-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS arm64 Debug (AppleClang, Ninja)",
      "inherits": "macos-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "macos-premiere-release",
      "displayName": "macOS arm64 Release + Premiere Pro plug-ins (AppleClang, Ninja)",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OSV_BUILD_PREMIERE": "ON",
        "OSV_PREMIERE_SDK_DIR": "${sourceDir}/Premiere Pro 26.0 C++ SDK",
        "OSV_AE_SDK_DIR": "${sourceDir}/third_party/ae-sdk"
      }
    },
    {
      "name": "ci-macos",
      "displayName": "CI (GitHub Actions macos-14, arm64)",
      "inherits": "macos-release"
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-cuda-release", "configurePreset": "windows-msvc-cuda-release" },
    { "name": "windows-msvc-cuda-debug",   "configurePreset": "windows-msvc-cuda-debug" },
    { "name": "windows-msvc-cpu-only",     "configurePreset": "windows-msvc-cpu-only" },
    { "name": "windows-msvc-premiere-release", "configurePreset": "windows-msvc-premiere-release" },
    { "name": "windows-msvc-premiere-debug",   "configurePreset": "windows-msvc-premiere-debug" },
    { "name": "windows-vs2022-cuda",       "configurePreset": "windows-vs2022-cuda", "configuration": "Release" },
    { "name": "ci-windows",                "configurePreset": "ci-windows" },
    { "name": "macos-release",             "configurePreset": "macos-release" },
    { "name": "macos-debug",               "configurePreset": "macos-debug" },
    { "name": "macos-premiere-release",    "configurePreset": "macos-premiere-release" },
    { "name": "ci-macos",                  "configurePreset": "ci-macos" }
  ],
  "testPresets": [
    {
      "name": "all",
      "configurePreset": "windows-msvc-cuda-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "debug-all",
      "configurePreset": "windows-msvc-cuda-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "cpu-only",
      "configurePreset": "windows-msvc-cpu-only",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "premiere",
      "configurePreset": "windows-msvc-premiere-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "ci",
      "configurePreset": "ci-windows",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "name": "cuda|opencl|hwaccel|ffmpeg-exe" } }
    },
    {
      "name": "macos",
      "configurePreset": "macos-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "macos-premiere",
      "configurePreset": "macos-premiere-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "ci-macos",
      "configurePreset": "ci-macos",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    }
  ]
}
