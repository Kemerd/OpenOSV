//
// osvgui.rc - OpenOSV Studio's icon and VERSIONINFO (configured by
// tools/osvgui/CMakeLists.txt; the version is the CMake project version).
//
// The icon is named GLFW_ICON: GLFW gives its windows the icon of that name
// from the executable, so the title bar, the taskbar and Explorer all show
// the same one.  osvgui.ico itself is drawn at build time (IconGen.cpp).

#include <winver.h>

GLFW_ICON ICON "@OSVGUI_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904b0 = US English, Unicode.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "The OpenOSV Contributors"
            VALUE "FileDescription",  "OpenOSV Studio - batch rendering for DJI Osmo 360 clips"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "osvgui"
            VALUE "LegalCopyright",   "Copyright (C) 2026 The OpenOSV Contributors. Apache-2.0."
            VALUE "OriginalFilename", "osvgui.exe"
            VALUE "ProductName",      "OpenOSV"
            VALUE "ProductVersion",   "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
