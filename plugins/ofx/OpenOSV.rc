//
// OpenOSV.rc - the VERSIONINFO of OpenOSV.ofx, so the file properties dialog
// and DaVinci Resolve's plug-in list show a real version and publisher.
//
// The numbers are the OpenFX plug-ins' own version (OfxReframe.h,
// OfxSource.h: 1.0), written out literally because rc.exe evaluates no C++.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 // An OpenFX binary is a DLL as far as Windows is concerned; .ofx is the
 // OpenFX convention, not a Windows file type.
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904b0 = US English, Unicode.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "The OpenOSV Contributors"
            VALUE "FileDescription",  "OpenOSV for OpenFX hosts - OpenOSV Source and OpenOSV 360 Reframe"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "OpenOSV"
            VALUE "LegalCopyright",   "Copyright (C) 2026 The OpenOSV Contributors. Apache-2.0."
            VALUE "OriginalFilename", "OpenOSV.ofx"
            VALUE "ProductName",      "OpenOSV"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
